<UserControl x:Class="GeoTechRadier.Views.ChargesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:GeoTechRadier.ViewModels"
             d:DataContext="{d:DesignInstance vm:MainViewModel}"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" Background="{StaticResource BrushFond}">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,18">
            <TextBlock Text="Charges" Style="{StaticResource TitreModule}"/>
            <TextBlock Text="Charges ponctuelles, lineiques et surfaciques appliquees au radier"
                       Style="{StaticResource SousTitreModule}"/>
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="300"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource Carte}" Margin="0,0,18,0">
                <TabControl BorderThickness="0" Background="Transparent">
                    <TabItem Header="Charges ponctuelles">
                        <StackPanel Margin="0,10,0,0">
                            <TextBlock Text="Force verticale F (kN), negative vers le bas."
                                       Foreground="{StaticResource BrushEncreDoux}" Margin="0,0,0,10"/>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                <Button Content="+ Ajouter une charge" Style="{StaticResource BoutonSecondaire}" Margin="0,0,8,0"
                                        Command="{Binding Donnees.AjouterPonctuelleCommand}"/>
                                <Button Content="Supprimer la charge selectionnee" Style="{StaticResource BoutonSecondaire}"
                                        Command="{Binding Donnees.SupprimerPonctuelleCommand}"/>
                            </StackPanel>
                            <DataGrid ItemsSource="{Binding Donnees.Ponctuelles}" SelectedItem="{Binding Donnees.PonctuelleSelectionnee}"
                                      AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" Height="340">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="X (m)" Binding="{Binding X}" Width="*"/>
                                    <DataGridTextColumn Header="Y (m)" Binding="{Binding Y}" Width="*"/>
                                    <DataGridTextColumn Header="F (kN)" Binding="{Binding P}" Width="*"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </StackPanel>
                    </TabItem>
                    <TabItem Header="Charges lineiques">
                        <StackPanel Margin="0,10,0,0">
                            <TextBlock Text="Definies par deux points extremes ; horizontales, verticales ou obliques."
                                       Foreground="{StaticResource BrushEncreDoux}" Margin="0,0,0,10"/>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                <Button Content="+ Ajouter une charge" Style="{StaticResource BoutonSecondaire}" Margin="0,0,8,0"
                                        Command="{Binding Donnees.AjouterLineiqueCommand}"/>
                                <Button Content="Supprimer la charge selectionnee" Style="{StaticResource BoutonSecondaire}"
                                        Command="{Binding Donnees.SupprimerLineiqueCommand}"/>
                            </StackPanel>
                            <DataGrid ItemsSource="{Binding Donnees.Lineiques}" SelectedItem="{Binding Donnees.LineiqueSelectionnee}"
                                      AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" Height="340">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="X1 (m)" Binding="{Binding X1}" Width="*"/>
                                    <DataGridTextColumn Header="Y1 (m)" Binding="{Binding Y1}" Width="*"/>
                                    <DataGridTextColumn Header="X2 (m)" Binding="{Binding X2}" Width="*"/>
                                    <DataGridTextColumn Header="Y2 (m)" Binding="{Binding Y2}" Width="*"/>
                                    <DataGridTextColumn Header="q (kN/m)" Binding="{Binding Q}" Width="*"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </StackPanel>
                    </TabItem>
                    <TabItem Header="Charges surfaciques">
                        <StackPanel Margin="0,10,0,0">
                            <TextBlock Text="Zone rectangulaire chargee, limitee au radier (verifie par le moteur)."
                                       Foreground="{StaticResource BrushEncreDoux}" Margin="0,0,0,10"/>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                <Button Content="+ Ajouter une charge" Style="{StaticResource BoutonSecondaire}" Margin="0,0,8,0"
                                        Command="{Binding Donnees.AjouterSurfaceCommand}"/>
                                <Button Content="Supprimer la charge selectionnee" Style="{StaticResource BoutonSecondaire}"
                                        Command="{Binding Donnees.SupprimerSurfaceCommand}"/>
                            </StackPanel>
                            <DataGrid ItemsSource="{Binding Donnees.Surfaces}" SelectedItem="{Binding Donnees.SurfaceSelectionnee}"
                                      AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" Height="340">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Xmin (m)" Binding="{Binding Xmin}" Width="*"/>
                                    <DataGridTextColumn Header="Ymin (m)" Binding="{Binding Ymin}" Width="*"/>
                                    <DataGridTextColumn Header="Xmax (m)" Binding="{Binding Xmax}" Width="*"/>
                                    <DataGridTextColumn Header="Ymax (m)" Binding="{Binding Ymax}" Width="*"/>
                                    <DataGridTextColumn Header="p (kPa)" Binding="{Binding Q}" Width="*"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </StackPanel>
                    </TabItem>
                </TabControl>
            </Border>

            <!-- ============ Aperçu graphique des charges ============ -->
            <Border Grid.Column="1" Style="{StaticResource Carte}">
                <StackPanel>
                    <TextBlock Text="POSITION SUR LE RADIER" Style="{StaticResource TitreCarte}" Margin="0,0,0,12"/>
                    <Viewbox Stretch="Uniform">
                        <Canvas Width="280" Height="280">
                            <Polygon Points="{Binding Donnees.ContourPoints}" Fill="{StaticResource BrushAccentDoux}"
                                     Stroke="{StaticResource BrushAccent}" StrokeThickness="2"/>
                            <ItemsControl ItemsSource="{Binding Donnees.PointsAffichage}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><Canvas/></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Ellipse Width="10" Height="10" Fill="{StaticResource BrushErreur}"
                                                 Canvas.Left="{Binding X}" Canvas.Top="{Binding Y}"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Canvas>
                    </Viewbox>
                    <TextBlock Text="● Charge ponctuelle" Foreground="{StaticResource BrushErreur}" Margin="0,10,0,0" FontSize="11.5"/>
                    <TextBlock Text="Cliquez sur 'Actualiser la vue' (module Radier &amp; Maillage) apres modification."
                               Foreground="{StaticResource BrushEncreDoux}" FontStyle="Italic" FontSize="11" Margin="0,8,0,0" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
