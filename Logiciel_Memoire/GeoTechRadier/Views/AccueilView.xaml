<UserControl x:Class="GeoTechRadier.Views.AccueilView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:GeoTechRadier.ViewModels"
             d:DataContext="{d:DesignInstance vm:MainViewModel}"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" Background="{StaticResource BrushFond}">
    <Grid>
        <StackPanel MaxWidth="620" HorizontalAlignment="Center" VerticalAlignment="Center">

            <!-- Identite -->
            <StackPanel HorizontalAlignment="Center" Margin="0,0,0,36">
                <Border Width="72" Height="72" CornerRadius="16" Background="{StaticResource BrushAccent}"
                        HorizontalAlignment="Center">
                    <TextBlock Text="GR" Foreground="White" FontSize="28" FontWeight="Bold"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <TextBlock Text="{x:Static vm:MainViewModel.TitreLogiciel}" FontSize="30" FontWeight="Bold"
                           HorizontalAlignment="Center" Margin="0,14,0,2"/>
                <TextBlock Text="{x:Static vm:MainViewModel.SousTitreLogiciel}" FontSize="14"
                           Foreground="{StaticResource BrushEncreDoux}" HorizontalAlignment="Center"/>
            </StackPanel>

            <!-- Actions principales -->
            <UniformGrid Columns="2" Margin="0,0,0,30">
                <Button Content="+  Nouveau projet" Style="{StaticResource BoutonPrimaire}" Margin="0,0,8,0"
                        Command="{Binding NouveauProjetCommand}" FontSize="14"/>
                <Button Content="Ouvrir un projet" Style="{StaticResource BoutonSecondaire}" Margin="8,0,0,0"
                        Command="{Binding OuvrirProjetCommand}" FontSize="14"/>
            </UniformGrid>

            <!-- Projets recents -->
            <Border Style="{StaticResource Carte}">
                <StackPanel>
                    <TextBlock Text="PROJETS RECENTS" Style="{StaticResource TitreCarte}" Margin="0,0,0,10"/>
                    <ItemsControl ItemsSource="{Binding ProjetsRecents}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" Margin="0,4"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="Aucun projet recent. Les projets ouverts ou enregistres apparaitront ici."
                               Foreground="{StaticResource BrushEncreDoux}" FontStyle="Italic" TextWrapping="Wrap"
                               Visibility="{Binding ProjetsRecents.Count, Converter={StaticResource CompteurVersVisibiliteInverse}}"/>
                </StackPanel>
            </Border>

            <TextBlock Margin="0,20,0,0" HorizontalAlignment="Center" Foreground="{StaticResource BrushEncreDoux}"
                       FontSize="11.5">
                <Run Text="Version"/>
                <Run Text="{x:Static vm:MainViewModel.Version}"/>
                <Run Text=" -- Moteur de calcul : GeoInfraRadier.cpp (elements finis, couplage plaque-sol)"/>
            </TextBlock>
        </StackPanel>
    </Grid>
</UserControl>
