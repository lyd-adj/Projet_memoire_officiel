<UserControl x:Class="GeoTechRadier.Views.SolView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:GeoTechRadier.ViewModels"
             xmlns:conv="clr-namespace:GeoTechRadier.Views.Converters"
             d:DataContext="{d:DesignInstance vm:MainViewModel}"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" Background="{StaticResource BrushFond}">
    <UserControl.Resources>
        <conv:EpaisseurVersHauteurConverter x:Key="EpaisseurVersHauteur"/>
    </UserControl.Resources>
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,18">
            <TextBlock Text="Sol" Style="{StaticResource TitreModule}"/>
            <TextBlock Text="Definition du sol multicouche (methode de Steinbrenner / Boussinesq, moteur C++)"
                       Style="{StaticResource SousTitreModule}"/>
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="220"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource Carte}" Margin="0,0,18,0">
                <StackPanel>
                    <TextBlock Text="STRATIGRAPHIE" Style="{StaticResource TitreCarte}" Margin="0,0,0,12"/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <Button Content="+ Ajouter une couche" Style="{StaticResource BoutonSecondaire}" Margin="0,0,8,0"
                                Command="{Binding Donnees.AjouterCoucheCommand}"/>
                        <Button Content="Supprimer la couche selectionnee" Style="{StaticResource BoutonSecondaire}"
                                Command="{Binding Donnees.SupprimerCoucheCommand}"/>
                    </StackPanel>
                    <DataGrid ItemsSource="{Binding Donnees.Couches}" SelectedItem="{Binding Donnees.CoucheSelectionnee}"
                              AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" Height="330">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Epaisseur (m)" Binding="{Binding Epaisseur}" Width="*"/>
                            <DataGridTextColumn Header="Module E (kPa)" Binding="{Binding E}" Width="*"/>
                            <DataGridTextColumn Header="Coeff. Poisson nu" Binding="{Binding Nu}" Width="*"/>
                            <DataGridCheckBoxColumn Header="Demi-espace infini" Binding="{Binding DemiEspaceInfini}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <TextBlock Margin="0,10,0,0" FontStyle="Italic" Foreground="{StaticResource BrushEncreDoux}" TextWrapping="Wrap"
                               Text="Une couche a epaisseur &lt;= 0 (ou cochee 'demi-espace infini') termine la stratigraphie : les couches suivantes sont ignorees par le moteur, comme en mode console."/>
                </StackPanel>
            </Border>

            <!-- ============ Coupe stratigraphique ============ -->
            <Border Grid.Column="1" Style="{StaticResource Carte}">
                <StackPanel>
                    <TextBlock Text="COUPE VERTICALE" Style="{StaticResource TitreCarte}" Margin="0,0,0,10"/>
                    <Border Height="18" Background="{StaticResource BrushEncre}" Margin="0,0,0,2"/>
                    <TextBlock Text="RADIER" FontSize="9.5" HorizontalAlignment="Center" Foreground="White"
                               Margin="0,-16,0,4" FontWeight="Bold"/>
                    <ItemsControl ItemsSource="{Binding Donnees.Couches}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Height="{Binding Epaisseur, Converter={StaticResource EpaisseurVersHauteur}}"
                                        Background="#DDE7EA" BorderBrush="{StaticResource BrushBordure}" BorderThickness="1,0,1,1">
                                    <TextBlock Text="{Binding E, StringFormat='E={0} kPa'}" FontSize="9.5"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                               Foreground="{StaticResource BrushEncreDoux}" TextWrapping="Wrap"/>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
