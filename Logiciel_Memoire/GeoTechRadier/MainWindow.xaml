<Window x:Class="GeoTechRadier.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:GeoTechRadier"
        xmlns:views="clr-namespace:GeoTechRadier.Views"
        xmlns:vm="clr-namespace:GeoTechRadier.ViewModels"
        mc:Ignorable="d"
        Title="GEOINFRARADIER -- Dimensionnement geotechnique des radiers" Height="820" Width="1360"
        MinHeight="620" MinWidth="1000"
        WindowStartupLocation="CenterScreen" Background="{StaticResource BrushFond}">
    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>
    <Window.Resources>
        <Style x:Key="ItemNav" TargetType="RadioButton">
            <Setter Property="GroupName" Value="nav"/>
            <Setter Property="Foreground" Value="{StaticResource BrushSidebarTexte}"/>
            <Setter Property="Padding" Value="18,12"/>
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="fond" Background="Transparent" BorderThickness="3,0,0,0" BorderBrush="Transparent">
                            <StackPanel Orientation="Horizontal" Margin="{TemplateBinding Padding}">
                                <Border Width="22" Height="22" CornerRadius="11" Background="#26323F" Margin="0,0,12,0">
                                    <TextBlock Text="{TemplateBinding Tag}" FontSize="11" FontWeight="Bold"
                                               Foreground="{TemplateBinding Foreground}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ContentPresenter VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="fond" Property="Background" Value="{StaticResource BrushSidebarActif}"/>
                                <Setter TargetName="fond" Property="BorderBrush" Value="White"/>
                                <Setter Property="Foreground" Value="{StaticResource BrushSidebarTexteActif}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="fond" Property="Background" Value="{StaticResource BrushSidebarSurvol}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <!-- Ecran d'accueil : occupe toute la fenetre tant qu'aucun projet n'est ouvert -->
        <views:AccueilView Visibility="{Binding ProjetEstOuvert, Converter={StaticResource BoolVersVisibiliteInverse}}"/>

        <!-- Espace de travail : barre superieure + navigation + contenu + barre d'etat -->
        <Grid Visibility="{Binding ProjetEstOuvert, Converter={StaticResource BoolVersVisibilite}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="52"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="28"/>
            </Grid.RowDefinitions>

            <!-- ============ Barre superieure ============ -->
            <Border Grid.Row="0" Background="{StaticResource BrushSidebar}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" Margin="16,0" VerticalAlignment="Center">
                        <TextBlock Text="{x:Static vm:MainViewModel.TitreLogiciel}" Foreground="White"
                                   FontWeight="Bold" FontSize="15" VerticalAlignment="Center"/>
                        <Rectangle Width="1" Height="20" Fill="#33FFFFFF" Margin="14,0"/>
                        <Button Content="Nouveau" Style="{StaticResource BoutonOutil}" Foreground="{StaticResource BrushSidebarTexte}"
                                Command="{Binding NouveauProjetCommand}" ToolTip="Creer un nouveau projet"/>
                        <Button Content="Ouvrir" Style="{StaticResource BoutonOutil}" Foreground="{StaticResource BrushSidebarTexte}"
                                Command="{Binding OuvrirProjetCommand}" ToolTip="Ouvrir un projet enregistre"/>
                        <Button Content="Enregistrer" Style="{StaticResource BoutonOutil}" Foreground="{StaticResource BrushSidebarTexte}"
                                IsEnabled="False" ToolTip="A venir : enregistrement de projet"/>
                        <Button Content="Exporter" Style="{StaticResource BoutonOutil}" Foreground="{StaticResource BrushSidebarTexte}"
                                Command="{Binding NaviguerCommand}" CommandParameter="{x:Static vm:EcranApplication.Visualisation}"
                                ToolTip="Exports disponibles depuis le module Visualisation"/>
                        <Button Content="Parametres" Style="{StaticResource BoutonOutil}" Foreground="{StaticResource BrushSidebarTexte}"
                                IsEnabled="False" ToolTip="A venir"/>
                    </StackPanel>
                    <TextBlock Grid.Column="1" Text="{x:Static vm:MainViewModel.SousTitreLogiciel}"
                               Foreground="{StaticResource BrushSidebarTexte}" FontSize="11.5"
                               HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,20,0"/>
                </Grid>
            </Border>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="210"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- ============ Navigation laterale ============ -->
                <Border Grid.Column="0" Background="{StaticResource BrushSidebar}">
                    <StackPanel Margin="0,14,0,0">
                        <RadioButton Style="{StaticResource ItemNav}" Content="Projet" Tag="1"
                                     IsChecked="{Binding EcranActif, Converter={StaticResource EnumEgal}, ConverterParameter=Projet}"
                                     Command="{Binding NaviguerCommand}" CommandParameter="{x:Static vm:EcranApplication.Projet}"/>
                        <RadioButton Style="{StaticResource ItemNav}" Content="Radier &amp; Maillage" Tag="2"
                                     IsChecked="{Binding EcranActif, Converter={StaticResource EnumEgal}, ConverterParameter=RadierMaillage}"
                                     Command="{Binding NaviguerCommand}" CommandParameter="{x:Static vm:EcranApplication.RadierMaillage}"/>
                        <RadioButton Style="{StaticResource ItemNav}" Content="Sol" Tag="3"
                                     IsChecked="{Binding EcranActif, Converter={StaticResource EnumEgal}, ConverterParameter=Sol}"
                                     Command="{Binding NaviguerCommand}" CommandParameter="{x:Static vm:EcranApplication.Sol}"/>
                        <RadioButton Style="{StaticResource ItemNav}" Content="Charges" Tag="4"
                                     IsChecked="{Binding EcranActif, Converter={StaticResource EnumEgal}, ConverterParameter=Charges}"
                                     Command="{Binding NaviguerCommand}" CommandParameter="{x:Static vm:EcranApplication.Charges}"/>
                        <RadioButton Style="{StaticResource ItemNav}" Content="Calcul" Tag="5"
                                     IsChecked="{Binding EcranActif, Converter={StaticResource EnumEgal}, ConverterParameter=Calcul}"
                                     Command="{Binding NaviguerCommand}" CommandParameter="{x:Static vm:EcranApplication.Calcul}"/>
                        <RadioButton Style="{StaticResource ItemNav}" Content="Resultats" Tag="6"
                                     IsChecked="{Binding EcranActif, Converter={StaticResource EnumEgal}, ConverterParameter=Resultats}"
                                     Command="{Binding NaviguerCommand}" CommandParameter="{x:Static vm:EcranApplication.Resultats}"/>
                        <RadioButton Style="{StaticResource ItemNav}" Content="Visualisation" Tag="7"
                                     IsChecked="{Binding EcranActif, Converter={StaticResource EnumEgal}, ConverterParameter=Visualisation}"
                                     Command="{Binding NaviguerCommand}" CommandParameter="{x:Static vm:EcranApplication.Visualisation}"/>
                    </StackPanel>
                </Border>

                <!-- ============ Zone de travail ============ -->
                <Grid Grid.Column="1" Background="{StaticResource BrushFond}">
                    <views:ProjetView Visibility="{Binding EcranActif, Converter={StaticResource EnumVersVisibilite}, ConverterParameter=Projet}"/>
                    <views:RadierMaillageView Visibility="{Binding EcranActif, Converter={StaticResource EnumVersVisibilite}, ConverterParameter=RadierMaillage}"/>
                    <views:SolView Visibility="{Binding EcranActif, Converter={StaticResource EnumVersVisibilite}, ConverterParameter=Sol}"/>
                    <views:ChargesView Visibility="{Binding EcranActif, Converter={StaticResource EnumVersVisibilite}, ConverterParameter=Charges}"/>
                    <views:CalculView Visibility="{Binding EcranActif, Converter={StaticResource EnumVersVisibilite}, ConverterParameter=Calcul}"/>
                    <views:ResultatsView Visibility="{Binding EcranActif, Converter={StaticResource EnumVersVisibilite}, ConverterParameter=Resultats}"/>
                    <views:VisualisationView Visibility="{Binding EcranActif, Converter={StaticResource EnumVersVisibilite}, ConverterParameter=Visualisation}"/>
                </Grid>
            </Grid>

            <!-- ============ Barre d'etat ============ -->
            <Border Grid.Row="2" Background="{StaticResource BrushStatutBar}">
                <Grid Margin="14,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding Projet.NomProjet}" Foreground="#AEB8C0" FontSize="11.5" VerticalAlignment="Center"/>
                        <TextBlock Text=" | " Foreground="#4A5560" VerticalAlignment="Center"/>
                        <TextBlock Text="{x:Static vm:MainViewModel.UnitesAffichees}" Foreground="#AEB8C0" FontSize="11.5" VerticalAlignment="Center"/>
                        <TextBlock Text=" | " Foreground="#4A5560" VerticalAlignment="Center"/>
                        <TextBlock Foreground="#AEB8C0" FontSize="11.5" VerticalAlignment="Center">
                            <Run Text="Noeuds : "/><Run Text="{Binding Resultats.Nn, Mode=OneWay}"/>
                        </TextBlock>
                        <TextBlock Text=" | " Foreground="#4A5560" VerticalAlignment="Center"/>
                        <TextBlock Foreground="#AEB8C0" FontSize="11.5" VerticalAlignment="Center">
                            <Run Text="Elements : "/><Run Text="{Binding Resultats.NbElements, Mode=OneWay}"/>
                        </TextBlock>
                    </StackPanel>
                    <TextBlock Text="{Binding MessageStatut}" Foreground="White" FontSize="11.5"
                               HorizontalAlignment="Right" VerticalAlignment="Center"/>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
