<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ============ Palette GEOINFRARADIER ============
         Identite "logiciel scientifique" : graphite/encre + bleu plan (blueprint),
         neutres a peine teintes plutot que du gris pur, un seul accent reserve
         aux actions principales et aux indicateurs d'etat actif. -->
    <SolidColorBrush x:Key="BrushFond" Color="#F3F5F6"/>
    <SolidColorBrush x:Key="BrushFondPanneau" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="BrushFondCarte" Color="#FAFBFB"/>
    <SolidColorBrush x:Key="BrushBordure" Color="#D8DEE2"/>
    <SolidColorBrush x:Key="BrushEncre" Color="#1B2430"/>
    <SolidColorBrush x:Key="BrushEncreDoux" Color="#5B6B78"/>

    <SolidColorBrush x:Key="BrushAccent" Color="#1F6F8B"/>
    <SolidColorBrush x:Key="BrushAccentFonce" Color="#154C60"/>
    <SolidColorBrush x:Key="BrushAccentDoux" Color="#E4EEF2"/>

    <SolidColorBrush x:Key="BrushSidebar" Color="#16212C"/>
    <SolidColorBrush x:Key="BrushSidebarTexte" Color="#C7D2DA"/>
    <SolidColorBrush x:Key="BrushSidebarTexteActif" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="BrushSidebarActif" Color="#1F6F8B"/>
    <SolidColorBrush x:Key="BrushSidebarSurvol" Color="#1F2C3A"/>

    <SolidColorBrush x:Key="BrushStatutBar" Color="#101821"/>
    <SolidColorBrush x:Key="BrushSucces" Color="#2E8B57"/>
    <SolidColorBrush x:Key="BrushAvertissement" Color="#B8842E"/>
    <SolidColorBrush x:Key="BrushErreur" Color="#B23A3A"/>

    <FontFamily x:Key="PoliceUI">Segoe UI</FontFamily>
    <FontFamily x:Key="PoliceIcones">Segoe MDL2 Assets</FontFamily>
    <FontFamily x:Key="PoliceMono">Cascadia Mono</FontFamily>

    <Style TargetType="{x:Type Window}">
        <Setter Property="FontFamily" Value="{StaticResource PoliceUI}"/>
        <Setter Property="Background" Value="{StaticResource BrushFond}"/>
        <Setter Property="Foreground" Value="{StaticResource BrushEncre}"/>
    </Style>

    <!-- Ne PAS fixer Foreground ici : un Setter sur un style implicite s'applique aussi aux
         TextBlock generes automatiquement par les ContentPresenter (boutons, RadioButton...),
         et ecraserait la couleur du texte sur fond sombre (barre superieure, navigation).
         Le Foreground par defaut vient de l'heritage depuis la Window (ci-dessus) ; chaque
         controle sur fond sombre fixe le sien explicitement (ex. BoutonOutil, ItemNav). -->
    <Style TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource PoliceUI}"/>
    </Style>

    <!-- ============ Titres de module / cartes ============ -->
    <Style x:Key="TitreModule" TargetType="TextBlock">
        <Setter Property="FontSize" Value="20"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource BrushEncre}"/>
    </Style>
    <Style x:Key="SousTitreModule" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12.5"/>
        <Setter Property="Foreground" Value="{StaticResource BrushEncreDoux}"/>
        <Setter Property="Margin" Value="0,2,0,0"/>
    </Style>
    <Style x:Key="TitreCarte" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource BrushAccentFonce}"/>
        <Setter Property="TextAlignment" Value="Left"/>
    </Style>
    <Style x:Key="EtiquetteChamp" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11.5"/>
        <Setter Property="Foreground" Value="{StaticResource BrushEncreDoux}"/>
        <Setter Property="Margin" Value="0,0,0,3"/>
    </Style>

    <!-- ============ Carte (Border) : unite visuelle de base des modules ============ -->
    <Style x:Key="Carte" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource BrushFondPanneau}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BrushBordure}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="6"/>
        <Setter Property="Padding" Value="16"/>
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect Color="#0A1A2430" Direction="270" ShadowDepth="1" BlurRadius="6" Opacity="0.10"/>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============ Champs de saisie ============ -->
    <Style TargetType="TextBox">
        <Setter Property="Padding" Value="7,6"/>
        <Setter Property="BorderBrush" Value="{StaticResource BrushBordure}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Background" Value="White"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Style.Triggers>
            <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter Property="BorderBrush" Value="{StaticResource BrushAccent}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ============ Boutons ============ -->
    <Style x:Key="BoutonPrimaire" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource BrushAccent}"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="Padding" Value="18,10"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="FontSize" Value="13.5"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource BrushAccentFonce}"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Background" Value="#9FB3BC"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="BoutonSecondaire" TargetType="Button" BasedOn="{StaticResource BoutonPrimaire}">
        <Setter Property="Background" Value="{StaticResource BrushFondPanneau}"/>
        <Setter Property="Foreground" Value="{StaticResource BrushEncre}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="BorderBrush" Value="{StaticResource BrushBordure}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource BrushAccentDoux}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Bouton d'outil de la barre superieure (icone + texte, etat actif/inactif) -->
    <Style x:Key="BoutonOutil" TargetType="Button">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{StaticResource BrushEncre}"/>
        <Setter Property="Padding" Value="10,6"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="fond" Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="fond" Property="Background" Value="{StaticResource BrushAccentDoux}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============ DataGrid professionnel ============ -->
    <Style TargetType="DataGrid">
        <Setter Property="Background" Value="White"/>
        <Setter Property="BorderBrush" Value="{StaticResource BrushBordure}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="RowHeaderWidth" Value="0"/>
        <Setter Property="GridLinesVisibility" Value="Horizontal"/>
        <Setter Property="HorizontalGridLinesBrush" Value="#EEF1F2"/>
        <Setter Property="AlternatingRowBackground" Value="#F7F9FA"/>
        <Setter Property="CanUserResizeRows" Value="False"/>
        <Setter Property="FontSize" Value="12.5"/>
        <Setter Property="RowHeight" Value="28"/>
    </Style>
    <Style TargetType="DataGridColumnHeader">
        <Setter Property="Background" Value="#EEF2F3"/>
        <Setter Property="Foreground" Value="{StaticResource BrushEncre}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="FontSize" Value="11.5"/>
        <Setter Property="Padding" Value="8,7"/>
        <Setter Property="BorderBrush" Value="{StaticResource BrushBordure}"/>
        <Setter Property="BorderThickness" Value="0,0,1,1"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
    </Style>
    <Style TargetType="DataGridCell">
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="8,4"/>
        <Style.Triggers>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="{StaticResource BrushAccentDoux}"/>
                <Setter Property="Foreground" Value="{StaticResource BrushEncre}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Selecteur segmente (ex. Type de radier : Rectangulaire / En L / En U) -->
    <Style x:Key="BoutonSegment" TargetType="RadioButton">
        <Setter Property="Padding" Value="18,10"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Foreground" Value="{StaticResource BrushEncre}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="fond" Background="{StaticResource BrushFondPanneau}" BorderBrush="{StaticResource BrushBordure}"
                            BorderThickness="1" CornerRadius="4" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="fond" Property="Background" Value="{StaticResource BrushAccent}"/>
                            <Setter TargetName="fond" Property="BorderBrush" Value="{StaticResource BrushAccent}"/>
                            <Setter Property="Foreground" Value="White"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="fond" Property="Background" Value="{StaticResource BrushAccentDoux}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="GroupBox">
        <Setter Property="Margin" Value="0,0,0,14"/>
        <Setter Property="Padding" Value="10"/>
        <Setter Property="BorderBrush" Value="{StaticResource BrushBordure}"/>
    </Style>

</ResourceDictionary>
